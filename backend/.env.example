# FastAPI
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-min-32-chars-0123456789ab

# PostgreSQL (main)
DATABASE_URL=postgresql://agro:agro123@localhost:5432/global_agro_br
SQLALCHEMY_ECHO=False

# TimescaleDB (time-series)
TIMESCALEDB_URL=postgresql://agro:agro123@localhost:5433/global_agro_br_ts

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PRICES=prices
KAFKA_TOPIC_RISK_METRICS=risk-metrics
KAFKA_TOPIC_HEDGE_RECOMMENDATIONS=hedge-recommendations
KAFKA_GROUP_ID=backend-service

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (alertas)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=noreply@globalagrobr.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
