B3_API_URL=https://api.b3.com.br/api/3
CBOT_API_KEY=
CBOT_API_URL=https://api.barchart.com/v2

# Redis (optional, for pub/sub scaling)
REDIS_URL=redis://localhost:6379

# Webhook
WEBHOOK_SECRET=change-me
